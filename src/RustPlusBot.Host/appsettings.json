{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "RustPlusBot.Features.Map.Assets.MonumentIconSource": "Information"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/rustplusbot-.log",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "Discord": {
    "Token": "",
    "ResetCommandsOnStartup": false
  },
  "Database": {
    "ConnectionString": "DataSource=rustplusbot.db"
  },
  "Workspace": {
    "EnableDangerCommands": false,
    "InfoRefreshInterval": "00:01:00"
  },
  "Pairing": {
    "ProbeTimeout": "00:00:08",
    "InitialRetryDelay": "00:00:05",
    "MaxRetryDelay": "00:05:00"
  },
  "Connections": {
    "ConnectTimeout": "00:00:30",
    "InitialRetryDelay": "00:00:05",
    "MaxRetryDelay": "00:05:00",
    "HeartbeatInterval": "00:01:00",
    "HeartbeatTimeout": "00:00:10",
    "MarkerPollInterval": "00:00:05",
    "MarkerPollFastInterval": "00:00:02",
    "RigRadius": 150,
    "RigActiveWindow": "00:15:00",
    "RigOfflineWindow": "00:15:00",
    "RigTickInterval": "00:00:30",
    "AfkThreshold": "00:05:00",
    "AfkEpsilon": 1,
    "ReachabilityPollInterval": "00:05:00"
  },
  "Commands": {
    "Cooldown": "00:00:04"
  },
  "Map": {
    "MapRefreshInterval": "00:00:30",
    "RustMaps": {
      "ApiKey": "",
      "GenerationPollInterval": "00:00:20"
    }
  }
}
